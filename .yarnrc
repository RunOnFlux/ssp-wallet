# Yarn classic (v1) reads this file; it ignores .yarnrc.yml.
# Never run dependency install scripts automatically (security review DEP-5).
# After `yarn install`, run `yarn setup`: @lavamoat/allow-scripts runs only the
# install scripts allowlisted in package.json "lavamoat.allowScripts" and then
# the root postinstall (patch-package + local plugin build).
ignore-scripts true
