{
  "name": "vite-plugin-lavamoat",
  "version": "1.1.0",
  "private": true,
  "description": "SSP Wallet build plugin: runs SES lockdown() before any bundle code on every page and checks the bundle against a committed LavaMoat policy at build time. It does not provide per-package compartments.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --shims",
    "dev": "tsup src/index.ts --format cjs,esm --dts --shims --watch"
  },
  "keywords": [
    "vite",
    "plugin",
    "lavamoat",
    "ses",
    "lockdown",
    "security",
    "supply-chain"
  ],
  "author": "SSP Team",
  "license": "MIT",
  "dependencies": {
    "ses": "1.15.0",
    "lavamoat-core": "17.1.3",
    "@lavamoat/aa": "4.3.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "25.9.5"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RunOnFlux/ssp-wallet"
  }
}
